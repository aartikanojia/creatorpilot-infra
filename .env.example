# ===============================
# Gemini
# ===============================
GEMINI_API_KEY=your_gemini_api_key_here

# ===============================
# Azure Open AI 
# ===============================
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ===============================
# Database (shared)
# ===============================
# API async DB URL (Docker network)
DATABASE_URL=postgresql+asyncpg://creatorpilot_admin:creatorpilot_secret@postgres:5432/creatorpilot
POSTGRES_DB=creatorpilot
POSTGRES_USER=creatorpilot_admin
POSTGRES_PASSWORD=creatorpilot_secret

# ===============================
# Google OAuth (YouTube)
# ===============================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# ===============================
# Razorpay
# ===============================
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ===============================
# Firebase
# ===============================
FIREBASE_CREDENTIALS=/secrets/firebase.json
