# Local development only.
# Azure production values belong in Azure Container Apps secrets/config,
# using azure.production.env.example as the mapping reference.

# ===============================
# Gemini
# ===============================
GEMINI_API_KEY=your_gemini_api_key_here

# ===============================
# Azure Open AI 
# ===============================
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ===============================
# Local Docker Compose database wiring for MCP
# ===============================
POSTGRES_URL=postgresql://creatorpilot_admin:creatorpilot_secret@postgres:5432/creatorpilot
DATABASE_URL=postgresql://creatorpilot_admin:creatorpilot_secret@postgres:5432/creatorpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=creatorpilot
POSTGRES_USER=creatorpilot_admin
POSTGRES_PASSWORD=creatorpilot_secret
POSTGRES_SSL_MODE=prefer

# ===============================
# Local Docker Compose Redis wiring for MCP
# ===============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# ===============================
# Local Docker Compose MCP routing for API
# ===============================
MCP_BASE_URL=http://creatorpilot-mcp:8001

# ===============================
# Google OAuth (YouTube)
# ===============================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# ===============================
# Razorpay
# ===============================
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ===============================
# Firebase
# ===============================
FIREBASE_CREDENTIALS=/secrets/firebase.json
