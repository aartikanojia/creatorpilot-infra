# Azure production environment template for CreatorPilot.
# Do not commit real production secrets. Store them in Azure Container Apps secrets/config.
#
# API:
# - public Azure Container App
# - owns gateway/auth/payment/firebase configuration
# - should point only to MCP's internal Azure URL
#
# MCP:
# - internal Azure Container App
# - owns direct PostgreSQL, Redis, and LLM configuration

# ===============================
# MCP - Azure PostgreSQL Flexible Server
# ===============================
POSTGRES_URL=postgresql://<app_db_user>:<url_encoded_password>@<pg-server>.postgres.database.azure.com:5432/<db_name>?sslmode=require
DATABASE_URL=postgresql://<app_db_user>:<url_encoded_password>@<pg-server>.postgres.database.azure.com:5432/<db_name>?sslmode=require
POSTGRES_HOST=<pg-server>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_USER=<app_db_user>
POSTGRES_PASSWORD=<azure-postgres-password>
POSTGRES_DB=<db_name>
POSTGRES_SSL_MODE=require

# ===============================
# MCP - Azure Cache for Redis
# ===============================
REDIS_HOST=<redis-name>.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=<azure-redis-access-key>
REDIS_DB=0
REDIS_SSL=true

# ===============================
# API - runtime routing
# ===============================
MCP_BASE_URL=http://<mcp-internal-fqdn-or-internal-app-url>
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<app-insights-key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/

# ===============================
# API - OAuth, notifications, and payments
# ===============================
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=https://<public-api-host>/auth/youtube/callback
# Mount the Firebase service account JSON into the API container at this path.
# Restart or redeploy the API container app after adding or rotating the mount.
FIREBASE_CREDENTIALS=/secrets/firebase.json
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
GOOGLE_PLAY_PACKAGE_NAME=com.creatorpilot.app
GOOGLE_PLAY_PRODUCT_ID=ytcreator_pro_monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/secrets/google-play-service-account.json
GOOGLE_PLAY_RTDN_TOKEN=<long-random-rtdn-shared-secret>
INTERNAL_SERVICE_TOKEN=<long-random-internal-service-token>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_SENDER_EMAIL=<alerts-from-email>
SMTP_RECIPIENT_EMAIL=<alerts-to-email>
SMTP_USE_TLS=true

# ===============================
# MCP - internal API bridge
# ===============================
API_INTERNAL_BASE_URL=https://<public-api-host>

# ===============================
# MCP - LLM configuration
# ===============================
AZURE_OPENAI_API_KEY=<azure-openai-key>
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
GEMINI_API_KEY=<gemini-key>
